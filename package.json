{
  "name": "design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de librerías de arquitectura frontend (tokens + components Angular) bajo el scope @romanmartinidev",
  "author": "Roman Martini <roman.martini.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roman-martini/design-system.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -F playground start",
    "start": "pnpm -F playground start",
    "storybook": "pnpm -F playground storybook",
    "storybook:build": "pnpm -F playground build-storybook",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "openspec": "openspec",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.7.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.7"
    }
  }
}
