{
  "name": "@romanmartinidev/components",
  "version": "0.2.0",
  "description": "Componentes Angular del sistema de diseño romanmartinidev — standalone + signals, consumen @romanmartinidev/tokens",
  "author": "Roman Martini <roman.martini.dev@gmail.com>",
  "license": "MIT",
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ng-packagr",
    "standalone",
    "signals",
    "romanmartinidev"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/roman-martini/design-system.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/roman-martini/design-system/tree/main/packages/components#readme",
  "bugs": {
    "url": "https://github.com/roman-martini/design-system/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/fesm2022/romanmartinidev-components.mjs",
  "module": "./dist/fesm2022/romanmartinidev-components.mjs",
  "types": "./dist/types/romanmartinidev-components.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/romanmartinidev-components.d.ts",
      "default": "./dist/fesm2022/romanmartinidev-components.mjs"
    },
    "./router": {
      "types": "./dist/types/romanmartinidev-components-router.d.ts",
      "default": "./dist/fesm2022/romanmartinidev-components-router.mjs"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "watch": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
    "test": "vitest"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.23.0",
    "@romanmartinidev/tokens": ">=0.1.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@romanmartinidev/tokens": "workspace:*",
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@lucide/angular": "^1.23.0",
    "@analogjs/vitest-angular": "^2.5.2",
    "@angular/build": "^21",
    "@angular/common": "^21",
    "@angular/compiler": "^21",
    "@angular/compiler-cli": "^21",
    "@angular/core": "^21",
    "@angular/platform-browser": "^21",
    "@angular/router": "^21",
    "@storybook/angular": "^10",
    "jsdom": "^27",
    "ng-packagr": "~21.0",
    "rxjs": "~7.8",
    "tslib": "^2",
    "typescript": "~5.9",
    "vitest": "^4",
    "zone.js": "^0.16.2"
  }
}
