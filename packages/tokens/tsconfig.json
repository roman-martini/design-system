{
  // Este package no compila TypeScript: su build es Style Dictionary (sd.config.mjs)
  // y su salida es CSS + JS generados. Este tsconfig existe sólo para typechequear
  // los specs, que el runner de tests transpila sin verificar tipos.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Los specs importan los JSON de tokens con import attributes
    // (`import x from '../src/…json' with { type: 'json' }`).
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "noEmit": true,
    // `node` es necesario desde aaa-041: los gates leen el build y los JSON fuente con
    // `node:fs`. La versión de @types/node se alinea con `.nvmrc` (22), no con la que el
    // árbol resuelve transitivamente para vite/vitest — typechequear contra los tipos de
    // una versión de Node distinta de la que se ejecuta habilita APIs inexistentes en CI.
    "types": ["vitest/globals", "node"]
  },
  // Los specs, más las declaraciones de tipos de la lógica portada en `scripts/`. El
  // `.mjs` en sí no entra: activar `checkJs` sobre un módulo que ya tiene su `.d.mts`
  // duplicaría las declaraciones. Ese archivo lo cubre ESLint.
  "include": ["test/**/*.ts", "scripts/**/*.d.mts"]
}
