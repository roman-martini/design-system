{
  "semantic": {
    "motion": {
      "transition": {
        "fast":          { "value": "{motion.duration.fast} {motion.easing.ease-out}" },
        "normal":        { "value": "{motion.duration.normal} {motion.easing.ease-out}" },
        "slow":          { "value": "{motion.duration.slow} {motion.easing.ease-out}" },
        "spring":        { "value": "{motion.duration.normal} {motion.easing.spring}" },
        "overlay-enter": {
          "value": "{motion.duration.normal} {motion.easing.ease-out}",
          "comment": "Alineado a la escala primitiva en aaa-052 (antes 250ms literal, fuera de escala). Convención: enter ≥ exit."
        },
        "overlay-exit": {
          "value": "{motion.duration.fast} {motion.easing.ease-in}",
          "comment": "Alineado a la escala primitiva en aaa-052 (antes 150ms literal, fuera de escala)."
        }
      }
    }
  }
}
